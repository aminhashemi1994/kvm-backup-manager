# Nginx configuration for KVM Backup Manager: access by IP ADDRESS
# (for access by domain name, use nginx.example)
#
# Replace 192.168.1.50 with your server's IP everywhere below.
#
# Public CAs don't issue certificates for private IPs, so use a self-signed
# certificate that includes the IP (browsers will show a one-time warning):
#
#   sudo mkdir -p /etc/nginx/ssl
#   sudo openssl req -x509 -nodes -newkey rsa:2048 -days 825 \
#     -keyout /etc/nginx/ssl/backup-manager.key \
#     -out    /etc/nginx/ssl/backup-manager.crt \
#     -subj   "/CN=192.168.1.50" \
#     -addext "subjectAltName=IP:192.168.1.50"
#
# Using HTTPS is strongly recommended: logins and the setup token are sent
# through this connection.
#
# Must match:
#   frontend/.env            VITE_BACKEND_URL=https://192.168.1.50/api-backup
#   controller-backend/.env  PORT=3000, SSL_ENABLED=false (nginx terminates TLS)
#
# If you run the controller with SSL_ENABLED=true instead, change both
# proxy_pass lines below to https:// and uncomment `proxy_ssl_verify off;`.

# Upgrade only real WebSocket requests; plain API calls keep normal keep-alive
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name 192.168.1.50;
    return 301 https://$host$request_uri;   # $host is the IP here
}

# HTTPS server
server {
    listen 443 ssl;
    http2 on;
    server_name 192.168.1.50;

    ssl_certificate     /etc/nginx/ssl/backup-manager.crt;
    ssl_certificate_key /etc/nginx/ssl/backup-manager.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Frontend build output (frontend/dist after `npm run build`)
    root  /var/www/html/backup-manager-panel/dist;
    index index.html;

    client_max_body_size 100M;

    access_log /var/log/nginx/backup-manager-access.log;
    error_log  /var/log/nginx/backup-manager-error.log;

    # Frontend (React/Vite SPA)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Controller API: /api-backup/* -> controller /api/*
    location /api-backup/ {
        proxy_pass http://127.0.0.1:3000/api/;
        # proxy_ssl_verify off;   # only with SSL_ENABLED=true (self-signed cert)

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 3600s;   # long-running reports / restores
        proxy_send_timeout 3600s;
    }

    # Socket.IO (real-time updates)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3000/socket.io/;
        # proxy_ssl_verify off;   # only with SSL_ENABLED=true (self-signed cert)

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
