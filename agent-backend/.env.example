# Agent Backend Configuration
NODE_ENV=development
PORT=3001

# Service IP - Set to 0.0.0.0 for all interfaces, 127.0.0.1 for localhost only
SERVICE_IP=0.0.0.0

# Controller URL (for callbacks and WebSocket)
# IMPORTANT: The agent will automatically discover its identity from the controller
# based on the port number. Make sure this agent is registered in the controller.
# NOTE: this MUST include the /api prefix — the agent requests paths like
# /backup-hosts and /storage-pools/..., which the controller mounts under /api.
CONTROLLER_URL=http://localhost:3000/api

# ── Controller TLS behaviour ────────────────────────────────────────────────
# An expired certificate must never stop backups. The agent therefore pins the
# controller's public key the first time it verifies cleanly, and if the cert
# later expires it keeps talking as long as the key still matches — the server
# is provably the same one, the calendar just rolled over. See
# services/controllerTlsService.js.
#
# What happens when the certificate is expired AND the public key changed. That
# combination is the signature of interception rather than expiry, so the
# default refuses the connection. Set to "warn" to keep traffic flowing even
# then (maximum availability, no authentication guarantee).
#   reject (default) | warn
CONTROLLER_TLS_ON_PIN_MISMATCH=reject

# Accept a self-signed / untrusted controller certificate. Intended for test
# environments; in production, prefer NODE_EXTRA_CA_CERTS with your CA.
CONTROLLER_TLS_ALLOW_SELF_SIGNED=false

# JWT Authentication for Agent
# 1. AGENT_JWT_TOKEN: Static token for agent -> controller calls (fetching storage pools, etc.)
#    IMPORTANT: Must match AGENT_STATIC_TOKEN in controller .env
#    Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AGENT_JWT_TOKEN=agent-static-token-change-this-in-production-use-long-random-string

# 2. AGENT_JWT_SECRET: Secret for controller -> agent calls (triggering backups, etc.)
#    IMPORTANT: Must match AGENT_JWT_SECRET in controller .env
#    Generate with: openssl rand -base64 32
AGENT_JWT_SECRET=agent-secret-key-change-in-production-use-openssl-rand-base64-32

# SSH Configuration
SSH_TIMEOUT=30000
SSH_READY_TIMEOUT=20000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Concurrent backups: managed centrally in the controller per backup
# host (Backup Hosts → Edit → "Max concurrent backups"). The agent
# pulls this value every 60 seconds and caches it locally; no agent
# restart needed when you change it. Setting this here is ignored.
