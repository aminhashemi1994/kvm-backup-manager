{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "Backup Manager \u2014 Virtual machines",
  "uid": "bm-vms",
  "version": 1,
  "weekStart": "",
  "tags": [
    "backup-manager"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "type": "query",
        "name": "vm",
        "label": "vm",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "definition": "label_values(bm_vm_info, vm)",
        "query": {
          "qryType": 1,
          "query": "label_values(bm_vm_info, vm)",
          "refId": "vm"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": []
      },
      {
        "type": "query",
        "name": "hypervisor",
        "label": "hypervisor",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "definition": "label_values(bm_vm_info, hypervisor)",
        "query": {
          "qryType": 1,
          "query": "label_values(bm_vm_info, hypervisor)",
          "refId": "hypervisor"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Protected VMs",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bm_vms_protected_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "protected"
        },
        {
          "refId": "B",
          "expr": "sum(bm_vms_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": null
    },
    {
      "type": "stat",
      "title": "Unprotected VMs",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bm_vms_total) - sum(bm_vms_protected_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": null
    },
    {
      "type": "stat",
      "title": "Overdue (past own RPO)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(\n  (time() - bm_vm_backup_last_success_timestamp_seconds)\n    > bm_vm_backup_expected_interval_seconds\n)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": null
    },
    {
      "type": "stat",
      "title": "Never backed up",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(\n  bm_vm_protected == 1\n    unless on(vm) bm_vm_backup_last_success_timestamp_seconds\n)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": null
    },
    {
      "type": "stat",
      "title": "Running / Queued",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bm_jobs_running_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "running"
        },
        {
          "refId": "B",
          "expr": "sum(bm_jobs_queued_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "queued"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": null
    },
    {
      "type": "stat",
      "title": "Offsite partial / failed",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(bm_vm_offsite_last_status == 1) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "partial"
        },
        {
          "refId": "B",
          "expr": "count(bm_vm_offsite_last_status == 2) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": null
    },
    {
      "type": "table",
      "title": "Job history \u2014 latest run per VM",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bm_vm_info{vm=~\"$vm\", hypervisor=~\"$hypervisor\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "bm_vm_backup_last_status{vm=~\"$vm\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "bm_vm_backup_progress_percent{vm=~\"$vm\"}\n  or (bm_vm_backup_last_status{vm=~\"$vm\"} == bool 0) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "bm_vm_backup_last_duration_seconds{vm=~\"$vm\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "bm_vm_backup_last_exit_code{vm=~\"$vm\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "bm_vm_backup_last_start_timestamp_seconds{vm=~\"$vm\"} * 1000",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "bm_vm_offsite_last_status{vm=~\"$vm\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "H",
          "expr": "bm_vm_offsite_targets{vm=~\"$vm\", result=\"success\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        },
        {
          "refId": "I",
          "expr": "bm_vm_offsite_targets_total{vm=~\"$vm\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        },
        {
          "refId": "J",
          "expr": "bm_vm_offsite_last_success_timestamp_seconds{vm=~\"$vm\"} * 1000",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "vm",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "__name__": true,
              "url": true,
              "instance": true,
              "job": true,
              "Value #A": true,
              "schedule_type": true,
              "vm_id": true,
              "Time 8": true,
              "Time 9": true,
              "Time 10": true
            },
            "renameByName": {
              "Value #B": "Status",
              "Value #C": "Progress",
              "Value #D": "Duration",
              "Value #E": "Exit",
              "Value #F": "Started",
              "Value #G": "Offsite",
              "vm": "VM",
              "method": "Method",
              "hypervisor": "Hypervisor",
              "backup_host": "Backup host",
              "schedule": "Schedule",
              "Value #H": "Offsite OK",
              "Value #I": "Offsite targets",
              "Value #J": "Offsite synced"
            },
            "indexByName": {
              "vm": 0,
              "method": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "hypervisor": 11,
              "backup_host": 12,
              "schedule": 13,
              "Value #I": 9,
              "Value #J": 10
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VM"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 330
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Method"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Completed",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Failed",
                        "color": "red",
                        "index": 1
                      },
                      "2": {
                        "text": "Skipped",
                        "color": "orange",
                        "index": 2
                      },
                      "3": {
                        "text": "Rejected",
                        "color": "text",
                        "index": 3
                      },
                      "4": {
                        "text": "Running",
                        "color": "blue",
                        "index": 4
                      },
                      "5": {
                        "text": "Queued",
                        "color": "text",
                        "index": 5
                      },
                      "6": {
                        "text": "Cancelled",
                        "color": "text",
                        "index": 6
                      },
                      "7": {
                        "text": "Retrying",
                        "color": "orange",
                        "index": 7
                      },
                      "-1": {
                        "text": "Unknown",
                        "color": "text",
                        "index": 8
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Progress"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "custom.width",
                "value": 200
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Exit"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "0",
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "\u2014",
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Offsite"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Replicated",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Partial",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "Failed",
                        "color": "red",
                        "index": 2
                      },
                      "3": {
                        "text": "Running",
                        "color": "blue",
                        "index": 3
                      },
                      "4": {
                        "text": "Retrying",
                        "color": "orange",
                        "index": 4
                      },
                      "5": {
                        "text": "Unknown",
                        "color": "text",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Offsite OK"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              },
              {
                "id": "description",
                "value": "Offsite destinations that replicated successfully on the last run"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Offsite targets"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "description",
                "value": "Total offsite destinations configured for this VM"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Offsite synced"
            },
            "properties": [
