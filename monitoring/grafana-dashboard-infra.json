          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "__name__": true,
              "url": true,
              "instance": true,
              "job": true,
              "Value #A": true,
              "host_id": true,
              "agent_url": true
