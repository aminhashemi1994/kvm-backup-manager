            "renameByName": {
              "backup_host": "Host",
              "Value #A": "State",
              "Value #B": "Last check",
              "Value #C": "Running",
              "Value #D": "Queued"
            },
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
